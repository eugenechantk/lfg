#!/bin/zsh
set -euo pipefail

service="dev.omg.lfg.cloudflare-access.pilot"
host_url="https://lfg-pro.eugenechantk.me"
host_urls_json='["https://lfg-pro.eugenechantk.me","https://lfg-air.eugenechantk.me"]'
script_dir="${0:A:h}"
output_path="$script_dir/../PrivateResources/BundledCloudflareAccess.private.json"

# Source of truth is the macOS Keychain pilot item. The desktop app's private
# fallback file (same JSON shape, present on every Mac that runs lfg) covers a
# build host whose Keychain never received the item — the Air, as of 2026-09-20.
fallback_file="$HOME/.cloudflared/lfg-access-service-token.private.json"
credential_json=$(security find-generic-password \
  -s "$service" \
  -a "$host_url" \
  -w 2>/dev/null) || {
    if [[ -r "$fallback_file" ]]; then
      print -u2 "No pilot credential in macOS Keychain for $host_url; using $fallback_file."
      credential_json=$(cat "$fallback_file")
    else
      print -u2 "No pilot credential found in macOS Keychain for $host_url, and no $fallback_file."
      exit 1
    fi
  }

mkdir -p "${output_path:h}"
umask 077
BUNDLED_HOST_URL="$host_url" \
BUNDLED_HOST_URLS_JSON="$host_urls_json" \
BUNDLED_CREDENTIAL_JSON="$credential_json" \
BUNDLED_OUTPUT_PATH="$output_path" \
/usr/bin/python3 <<'PY'
import json
import os
from pathlib import Path

credential = json.loads(os.environ["BUNDLED_CREDENTIAL_JSON"])
payload = {
    "hostURL": os.environ["BUNDLED_HOST_URL"],
    "hostURLs": json.loads(os.environ["BUNDLED_HOST_URLS_JSON"]),
    "clientID": credential["clientID"],
    "clientSecret": credential["clientSecret"],
}
output = Path(os.environ["BUNDLED_OUTPUT_PATH"])
temporary = output.with_suffix(output.suffix + ".tmp")
temporary.write_text(json.dumps(payload, separators=(",", ":")) + "\n")
temporary.chmod(0o600)
temporary.replace(output)
PY

print "Generated private Cloudflare Access resource at ${output_path#$script_dir/../}."
