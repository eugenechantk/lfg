node_modules/
web/node_modules/
web/dist/
data/
.env
.env.*
!.env.example
.creds.json
*.db
*.log
.DS_Store
dist/
.flowdeck/
.build/

# Fastlane (iOS TestFlight) — .env.local is already covered by .env.* above
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/
ios/build/
ios/**/*.ipa
ios/**/*.dSYM.zip
ios/vendor/bundle/
ios/.bundle/

# Debug screenshot dumps (large, throwaway)
.claude/shots/
# Provisioning profiles (fastlane regenerates per deploy)
*.mobileprovision

# Syncthing conflict copies + migration backups
*.sync-conflict-*
ios/fastlane/*.bak

# Transient verification evidence + tool state
.codex/evidence/
# Screen recordings are evidence too, but they are 3-8MB each and the repo keeps
# every one forever. Commit the extracted stills (the house pattern) and leave the
# source recordings on the machine that captured them.
.claude/evidence/**/*.mov
.playwright-mcp/

# Desktop app build output
desktop/build/
.worktrees/
