# Build context is generated by build.py; it contains verified tools, never credentials.
FROM ghcr.io/trycua/linux@sha256:fd00735ceb6c65ab628d962640068c9f63076a49a62d86f6b6eb5ac4bbcbbf6b
COPY tools/ /opt/cua/tools/
COPY gog.tar.gz /tmp/lfg-gog.tar.gz
COPY config.toml /etc/codex/config.toml
RUN tar -xzf /tmp/lfg-gog.tar.gz -C /usr/local/bin ./gog \
 && rm /tmp/lfg-gog.tar.gz \
 && ln -sfn /opt/cua/tools/node/24.21.0/bin/node /usr/local/bin/node \
 && ln -sfn /opt/cua/tools/node/24.21.0/bin/npm /usr/local/bin/npm \
 && ln -sfn /opt/cua/tools/node/24.21.0/bin/npx /usr/local/bin/npx \
 && ln -sfn /opt/cua/tools/codex-acp/1.13.1/node_modules/.bin/codex /usr/local/bin/codex \
 && ln -sfn /opt/cua/tools/codex-acp/1.13.1/node_modules/.bin/codex-acp /usr/local/bin/codex-acp \
 && mkdir -p /home/cua/.cua/tools/acp-sdk /home/cua/.cua/tools/node /home/cua/.cua/tools/codex-acp /home/cua/.cua/tools/mcp-remote \
 && ln -s /opt/cua/tools/acp-sdk/1.5.0 /home/cua/.cua/tools/acp-sdk/1.5.0 \
 && ln -s /opt/cua/tools/node/24.21.0 /home/cua/.cua/tools/node/24.21.0 \
 && ln -s /opt/cua/tools/codex-acp/1.13.1 /home/cua/.cua/tools/codex-acp/1.13.1 \
 && ln -s /opt/cua/tools/mcp-remote/0.14.3 /home/cua/.cua/tools/mcp-remote/0.14.3 \
 && chown -R cua:cua /home/cua/.cua \
 && ln -sfn /usr/bin/python3 /usr/local/bin/python \
 && node --version && codex --version && gog --version && python3 --version && git --version
LABEL ai.lfg.profile="codex" ai.lfg.profile.version="1"
