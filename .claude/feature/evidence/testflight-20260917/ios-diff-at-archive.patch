+    func invalidate() {
+        lock.lock()
+        let tasks = Array(tasksByRequest.values)
+        tasksByRequest.removeAll()
+        requestsByTask.removeAll()
+        lock.unlock()
+        tasks.forEach { $0.cancel() }
+        session.invalidateAndCancel()
+    }
