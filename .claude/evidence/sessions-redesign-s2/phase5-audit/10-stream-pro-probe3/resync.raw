data: {"sid":"04a23c5d-d305-4388-9869-a2a957c00c6f","m":{"id":"67b76983-7871-4fac-b1b1-8e108d329e79","role":"assistant","kind":"tool_use","text":"Bash: {\n  \"command\": \"set -a; source ~/.config/meta-ads.env; set +a\\ncurl -sg \\\"https://graph.facebook.com/v23.0/120253063959590131?fields=name,preview_shareable_link&access_token=$ACCESS_TOKEN\\\"\",\n  \"description\": \"Get a shareable preview link for the Beginner friendly ad\"\n}","ts":1792138855756,"toolUseId":"toolu_01QniVThC5EaAvYa5tCasB2W","tool":{"name":"Bash","target":"set -a; source ~/.config/meta-ads.env; set +a"}}}

